# ========================================================
# NEXORA ENVIRONMENT CONFIGURATION (.env.example)
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String
# Option 1 (Local MongoDB): mongodb://localhost:27017/nexora
# Option 2 (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexora?retryWrites=true&w=majority
# Option 3 (Zero-config memory fallback): Leave blank or default, Nexora will seamlessly activate in-memory MongoDB storage!
MONGODB_URI=mongodb://localhost:27017/nexora

# JWT Secret Key for token generation
JWT_SECRET=nexora_production_super_secret_jwt_key_2026_acdyon_challenge_token

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
